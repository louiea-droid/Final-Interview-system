rules_version = '2';

// The public board reads everything; only the admin account can change it.
// Add another admin by appending their Firebase Auth UID to the list.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid in ['tNRXV3YjwghpgnORmJrOPcGgHKr2'];
    }

    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
