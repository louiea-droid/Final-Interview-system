rules_version = '2';

// Candidate photos are public on the board; only the admin account uploads.
// Keep the UID list in step with firestore.rules.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid in ['tNRXV3YjwghpgnORmJrOPcGgHKr2'];
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
