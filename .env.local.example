# Admin sign-in for the local build.
#
# vite.config.js maps these two into the browser bundle, so treat them as
# public: anyone with the built site can read them. They exist so the admin
# screens can be used while everything runs locally.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Firebase web config - see src/lib/firebase/config.js. This is Firebase's
# public per-app config, not a secret (Vite exposes any VITE_* variable to
# the browser automatically). Copy the values from the Firebase console:
# Project settings > General > Your apps > SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
