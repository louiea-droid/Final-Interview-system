# Firebase web config - see src/lib/firebase/config.js. This is Firebase's
# public per-app config, not a secret (Vite exposes any VITE_* variable to
# the browser automatically). Copy the values from the Firebase console:
# Project settings > General > Your apps > SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
